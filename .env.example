# Shared
NODE_ENV=development

# API
API_PORT=4000
MONGODB_URI=mongodb://localhost:27017/zyvora
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-strong-access-secret
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
CLIENT_WEB_URL=http://localhost:3000
ADMIN_WEB_URL=http://localhost:3001
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback
ADMIN_BOOTSTRAP_KEY=replace-with-strong-bootstrap-key

# Customer web
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_BRAND_NAME=Zyvora

# Admin web
NEXT_PUBLIC_ADMIN_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_ADMIN_BRAND_NAME=Zyvora Control Center
